<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.devMart.mapper.OrderMapper">
    <!-- 주문 상세(주문+주문상품 리스트) 계층형 resultMap -->
    <resultMap id="orderDetailMap" type="kr.co.devMart.common.util.CamelMap">
        <id javaType="java.lang.Long" column="ORDER_SEQ" property="orderSeq"/>
        <result javaType="java.lang.String" column="USER_SEQ" property="userSeq"/>
        <result javaType="java.lang.Integer" column="TOTAL_PRICE" property="totalPrice"/>
        <result javaType="java.lang.String" column="STATUS" property="status"/>
        <result javaType="java.util.Date" column="CREATE_DATE" property="createDate"/>
        <result javaType="java.util.Date" column="UPDATE_DATE" property="updateDate"/>
        <!-- 주문별 상품 리스트 -->
        <collection property="orderItems" javaType="java.util.ArrayList" resultMap="orderItemMap"/>
    </resultMap>
    <!-- 주문상품 resultMap (주문 상세 내 컬렉션) -->
    <resultMap id="orderItemMap" type="kr.co.devMart.common.util.CamelMap">
        <id javaType="java.lang.Long" column="ORDER_ITEM_SEQ" property="orderItemSeq"/>
        <result javaType="java.lang.Long" column="ORDER_SEQ" property="orderSeq"/>
        <result javaType="java.lang.Long" column="PRODUCT_SEQ" property="productSeq"/>
        <result javaType="java.lang.String" column="PRODUCT_NAME" property="productName"/>
        <result javaType="java.lang.Integer" column="PRICE" property="price"/>
        <result javaType="java.lang.Integer" column="QUANTITY" property="quantity"/>
        <result javaType="java.util.Date" column="CREATE_DATE" property="createDate"/>
        <result javaType="java.util.Date" column="UPDATE_DATE" property="updateDate"/>
    </resultMap>

    <!-- 사용자별 주문 목록 조회 (단순 리스트, resultType=Map) -->
    <select id="selectOrderListByUser" parameterType="map" resultType="kr.co.devMart.common.util.CamelMap">
        SELECT O.ORDER_SEQ
            , O.USER_SEQ
            , O.TOTAL_PRICE
            , O.STATUS
            , O.CREATE_DATE
            , O.UPDATE_DATE
            , OI.ORDER_ITEM_SEQ
            , OI.PRODUCT_SEQ
            , OI.PRODUCT_NAME
            , OI.PRICE
            , OI.QUANTITY
            , P.NAME AS PRODUCT_NAME
        FROM TB_ORDER O
            INNER JOIN TB_ORDER_ITEM OI
                ON O.ORDER_SEQ = OI.ORDER_SEQ
            INNER JOIN TB_PRODUCT P
                ON OI.PRODUCT_SEQ = P.PRODUCT_SEQ
        WHERE O.USER_SEQ = #{userSeq}
        ORDER BY O.CREATE_DATE DESC
    </select>

    <!-- 주문 상세(주문+주문상품)조회 -->
    <select id="selectOrderDetail" parameterType="map" resultMap="orderDetailMap">
        SELECT * FROM TB_ORDER WHERE ORDER_SEQ = #{orderSeq};
        SELECT * FROM TB_ORDER_ITEM WHERE ORDER_SEQ = #{orderSeq};
    </select>

    <!-- 주문 생성 -->
    <insert id="insertOrder" parameterType="map" useGeneratedKeys="true" keyProperty="orderSeq">
        INSERT INTO TB_ORDER (USER_SEQ
            , TOTAL_PRICE
            , STATUS
            , CREATE_DATE)
        VALUES (#{userSeq}
            , #{totalPrice}
            , #{status}
            , NOW())
    </insert>

    <!-- 주문상품 추가 -->
    <insert id="insertOrderItem" parameterType="map">
        INSERT INTO TB_ORDER_ITEM (ORDER_SEQ
            , PRODUCT_SEQ
            , PRODUCT_NAME
            , PRICE
            , QUANTITY
            , CREATE_DATE)
        VALUES (#{orderSeq}
            , #{productSeq}
            , #{productName}
            , #{price}
            , #{quantity}
            , NOW())
    </insert>

    <!-- 주문 상태 변경(취소 등) -->
    <update id="updateOrderStatus" parameterType="map">
        UPDATE TB_ORDER
        SET STATUS      = #{status}
            , UPDATE_DATE = NOW()
        WHERE ORDER_SEQ = #{orderSeq}
    </update>

    <!-- 주문 삭제 -->
    <delete id="deleteOrder" parameterType="map">
        DELETE FROM TB_ORDER WHERE ORDER_SEQ = #{orderSeq}
    </delete>

    <!-- 주문 완료 후 장바구니 전체 비우기 -->
    <delete id="deleteCartByUser" parameterType="map">
        DELETE FROM TB_CART WHERE USER_SEQ = #{userSeq}
    </delete>
</mapper>
